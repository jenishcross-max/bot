GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Модель с поддержкой изображений (клиент присылает фото причёски вместо описания)
GROQ_VISION_MODEL=qwen/qwen3.6-27b
# Модель распознавания речи (голосовые сообщения в Telegram-админке)
GROQ_AUDIO_MODEL=whisper-large-v3

# --- Салон красоты / парикмахерская ---
# Клиент записывается прямо в WhatsApp, владелец ведёт записи в Telegram.
# Склада, остатков и «штук» здесь нет: услуга не считается поштучно.
# Перед первым запуском выполните supabase_schema.sql, а затем
# supabase_salon_step1.sql — там колонки длительности и снятие RLS с записей.
SALON_NAME=Салон красоты «Алина»
SALON_ADDRESS=г. Бишкек, ул. Киевская 100
SALON_PHONE=+996 555 00 00 00
# Часы работы. Отсюда же строится сетка свободных окошек.
SALON_HOURS=09:00-20:00
# Часовой пояс салона. Сервер живёт по UTC, а «завтра в 15:00» клиент говорит
# по своим часам — без этого записи уезжают на несколько часов.
SALON_TZ=Asia/Bishkek
# Мастера через запятую — только для первого запуска. Дальше состав салона живёт
# в базе и правится в Телеграме: «👤 Мастера» → «⚙️ Настроить мастеров», там же
# рабочие дни, выходные и услуги каждого. Эта строка нужна, чтобы справочник
# заполнился сам, и остаётся запасным составом, если база вдруг недоступна.
# Пусто — салон считается «в одно кресло»: мастера не спрашиваем, а занятым
# считаем любое пересечение по времени.
SALON_MASTERS=Айгуль,Динара
# Длительность услуги, у которой она не проставлена в прайсе.
SALON_SLOT_MINUTES=60
# Шаг сетки времени: как часто вообще предлагаются окошки (09:00, 09:30, 10:00...).
# Это не то же самое, что длительность: стрижка на 40 минут не должна съедать час.
SALON_SLOT_STEP=30
# За сколько минут до начала окошко перестаёт предлагаться клиенту:
# «свободно через пять минут» — это не предложение, клиент не успеет доехать.
SALON_LEAD_MINUTES=30

# --- Напоминания клиентам ---
# Бот сам пишет клиенту в WhatsApp накануне записи. Час — по времени салона.
# Девятнадцать: человек уже не на работе, но ещё не спит, и успевает отменить —
# салону останется вечер и утро, чтобы отдать окошко другому.
SALON_REMINDER_HOUR=19
# Если запись сделали позже этого часа, напомним за столько минут до начала.
SALON_REMINDER_LEAD_MINUTES=120
# Напоминания требуют supabase_salon_step3.sql (колонка reminded_at). Пока он не
# выполнен, они выключены, и бот пишет об этом на экране «Записи на сегодня».
# ВАЖНО про бесплатный Render: уснувший сервис ничего не отправляет. Заведите
# внешний будильник (cron-job.org, UptimeRobot) на адрес
# https://ваш-сервис.onrender.com/cron раз в 5–10 минут — он и разбудит сервис,
# и запустит рассылку. Проснувшись, бот сразу догоняет пропущенное, но ночью
# (22:00–08:00) молчит и ждёт утра.
# Промпт администратора салона. Если пусто — бот соберёт его сам.
SALON_SYSTEM_PROMPT=

# Валюта, в которой бот называет цены клиентам
CURRENCY=сом

# Текст, который бот отправляет клиенту при просьбе позвать администратора.
# Если не задан — собирается автоматически из телефона, адреса и часов работы выше.
MANAGER_CONTACT_TEXT=

# Пароль к странице /qr, где QR-код WhatsApp показывается картинкой.
# Нужен на сервере: в логах Render код отсканировать невозможно.
# Без него страница не открывается — кто отсканирует код, тот привяжет
# к боту свой WhatsApp, поэтому наружу её выставлять нельзя.
QR_TOKEN=придумайте_длинную_строку

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# --- Telegram-админка (записи салона) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
# Ваш Telegram ID (узнать у @userinfobot), через запятую если админов несколько
ADMIN_TELEGRAM_IDS=123456789

# Публичный адрес сервиса. Если он задан, Telegram присылает сообщения сам
# (вебхук) — на бесплатном Render это единственный рабочий вариант: уснувший
# сервис ничего не опрашивает, зато от входящего запроса просыпается.
# На Render подставляется автоматически (RENDER_EXTERNAL_URL), локально не нужен.
# ВАЖНО: локальный запуск снимает вебхук с сервера — после него перезапустите
# сервис на Render, иначе бот там останется молчать.
PUBLIC_URL=

# Старые имена SHOP_NAME / SHOP_ADDRESS / SHOP_PHONE / SHOP_HOURS ещё читаются
# как запасной вариант — если они уже заполнены на сервере, заводить SALON_*
# заново не нужно. Всё остальное магазинное (SHOP_MODE, склад, торг, накладные)
# удалено: эта версия бота работает только как салон.
