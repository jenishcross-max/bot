GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Модель с поддержкой изображений (для распознавания фото накладных в Telegram-админке)
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Модель распознавания речи (голосовые сообщения в Telegram-админке)
GROQ_AUDIO_MODEL=whisper-large-v3
# При каком остатке товар считается заканчивающимся (для сводки по складу)
LOW_STOCK_THRESHOLD=5

# Системный промпт, задаёт поведение бота
SYSTEM_PROMPT=Ты — дружелюбный ассистент по трудоустройству в WhatsApp. Отвечай кратко и по делу на русском языке. Помогай пользователям с вопросами о вакансиях и трудоустройстве.

# --- Режим магазина (каталог товаров через Supabase) ---
# Установите SHOP_MODE=true, чтобы WhatsApp-бот отвечал на основе товаров из базы.
SHOP_MODE=false
# Промпт продавца-консультанта (используется вместо SYSTEM_PROMPT при SHOP_MODE=true)
SHOP_SYSTEM_PROMPT=Ты — вежливый продавец-консультант магазина, отвечаешь клиентам в WhatsApp. Отвечай кратко, на русском, только по данным каталога.

# --- Режим салона красоты / парикмахерской ---
# Клиент записывается прямо в WhatsApp, владелец видит записи в Telegram
# («📅 Записи на сегодня»). Услуги лежат в том же каталоге, что и товары.
# Не забудьте выполнить в Supabase создание таблицы appointments из supabase_schema.sql.
SALON_MODE=false
SALON_NAME=Салон красоты «Алина»
# Часовой пояс салона. Сервер живёт по UTC, а «завтра в 15:00» клиент говорит
# по своим часам — без этого записи уезжают на несколько часов.
SALON_TZ=Asia/Bishkek
# Часы работы. Если не задать — возьмутся из SHOP_HOURS.
SALON_HOURS=09:00-20:00
# Мастера через запятую. Если пусто — бот не спрашивает мастера, а занятым
# считает любое пересечение по времени.
SALON_MASTERS=Айгуль,Динара
# Сколько минут занимает одна запись — по нему строится сетка свободных окошек
# и проверяется, занято ли время.
SALON_SLOT_MINUTES=60
# За сколько минут до начала окошко перестаёт предлагаться клиенту:
# «свободно через пять минут» — это не предложение, клиент не успеет доехать.
SALON_LEAD_MINUTES=30
# Промпт администратора салона (используется вместо SHOP_SYSTEM_PROMPT при SALON_MODE=true)
SALON_SYSTEM_PROMPT=

# Валюта, в которой бот называет цены клиентам
CURRENCY=сом

# --- Режим «Торгаш» ---
# Клиент торгуется — бот отшучивается, но цену не снижает никогда:
# правило прописано в промпте и продублировано фильтром ответа.
HAGGLE_MODE=false
# Игровая плашка «🎮 Раунд 2 · Уверенный покупатель» под ответом. false — убрать.
HAGGLE_BADGES=true
# На какой попытке торга владельцу уходит уведомление в Telegram
# (клиент, который торгуется четвёртый раз, уже хочет купить). 0 — выключить.
HAGGLE_NOTIFY_ROUND=4
# Единственная уступка, которую боту разрешено обещать вместо скидки.
# Не пишите сюда ничего, что стоит денег: доставку и подарки обещает владелец, не бот.
HAGGLE_BONUS=придержу товар до конца дня

# Данные магазина — по ним бот отвечает на вопросы про адрес, часы работы и доставку
SHOP_NAME=Магазин у дома
SHOP_ADDRESS=г. Алматы, ул. Абая 10
SHOP_PHONE=+7 700 000 00 00
SHOP_HOURS=Пн-Вс, 09:00-21:00
SHOP_DELIVERY=По городу, от 5000 тенге — бесплатно
# Текст, который бот отправляет клиенту при просьбе связаться с менеджером.
# Если не задан — собирается автоматически из телефона, адреса и часов работы выше.
MANAGER_CONTACT_TEXT=
# Пароль к странице /qr, где QR-код WhatsApp показывается картинкой.
# Нужен на сервере: в логах Render код отсканировать невозможно.
# Без него страница не открывается — кто отсканирует код, тот привяжет
# к боту свой WhatsApp, поэтому наружу её выставлять нельзя.
QR_TOKEN=придумайте_длинную_строку

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# --- Telegram-бот-админка (записи салона / загрузка товаров) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
# Ваш Telegram ID (узнать у @userinfobot), через запятую если админов несколько
ADMIN_TELEGRAM_IDS=123456789

# Публичный адрес сервиса. Если он задан, Telegram присылает сообщения сам
# (вебхук) — на бесплатном Render это единственный рабочий вариант: уснувший
# сервис ничего не опрашивает, зато от входящего запроса просыпается.
# На Render подставляется автоматически (RENDER_EXTERNAL_URL), локально не нужен.
# ВАЖНО: локальный запуск снимает вебхук с сервера — после него перезапустите
# сервис на Render, иначе бот там останется молчать.
PUBLIC_URL=
